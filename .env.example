# Copy this file to .env and fill in your values

# Port for the local server / dashboard
PORT=3000

# How often to check for fresh news, in hours
# NOTE: if you enable GOOGLE_CSE_KEY/CX below, keep this at 4+ hours --
# 16 areas x 6 refreshes/day = 96 queries, within the 100/day free CSE
# quota. Every 2 hours would use ~192/day and start failing partway through.
FETCH_INTERVAL_HOURS=2

# --- OPTIONAL: NewsAPI.org key (free tier: newsapi.org/register) ---
# Leave blank to rely solely on Google News RSS (works fine without a key)
NEWSAPI_KEY=

# --- OPTIONAL: Google Custom Search JSON API ---
# This is the closest match to "browsing google.com and reading the
# snippets" -- it returns whatever's indexed (news, blogs, forums, official
# notices, PDFs), not just Google News-tagged publishers. Free tier: 100
# queries/day. Setup: console.cloud.google.com (enable "Custom Search API",
# create an API key) + programmablesearchengine.google.com (create a search
# engine, turn ON "Search the entire web", copy its Search engine ID as CX).
# Leave both blank to skip this source entirely.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Only show articles/results from the last N days
NEWS_WINDOW_DAYS=15

# --- Email digest (optional but recommended) ---
# Set EMAIL_ENABLED=true to turn on notifications
EMAIL_ENABLED=false

# Gmail example: use an "App Password", not your normal password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword

# Who receives the digest. Comma-separate multiple addresses.
NOTIFY_TO=youraddress@gmail.com
NOTIFY_FROM="Kompally Connect News <youraddress@gmail.com>"
